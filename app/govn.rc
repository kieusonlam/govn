    BEGIN
      VALUE "FileDescription", "govn - Vietnamese keyboard for Windows"
      VALUE "FileVersion", "0.2.0"
      VALUE "InternalName", "govn"
      VALUE "LegalCopyright", "GPL-3.0-or-later. Engine ported from UniKey / ibus-unikey, see NOTICE."
      VALUE "OriginalFilename", "govn.exe"
      VALUE "ProductName", "govn"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
