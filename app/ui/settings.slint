// The settings window. Rust (settings.rs) owns the data; this file only lays it out.
import { Button, ComboBox, Palette, ScrollView, Switch, TabWidget } from "std-widgets.slint";

// A group of rows on a slightly raised surface.
component Card inherits Rectangle {
    in property <string> title;
    background: Palette.alternate-background;
    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.border;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        if root.title != "": Text {
            text: root.title;
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
        }
        @children
    }
}

// A label, an optional explanation underneath, and a switch on the right.
component ToggleRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> detail;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            wrap: word-wrap;
            color: root.enabled ? Palette.foreground : Palette.foreground.transparentize(0.5);
        }
        if root.detail != "": Text {
            text: root.detail;
            wrap: word-wrap;
            font-size: 11.5px;
            color: Palette.foreground.transparentize(0.4);
        }
    }
    VerticalLayout {
        alignment: center;
        Switch {
            enabled: root.enabled;
            checked <=> root.checked;
            toggled => { root.toggled(self.checked); }
        }
    }
}

// Two choices side by side; the chosen one is filled with the accent colour.
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback chosen(int);
    height: 34px;
    border-radius: 8px;
    background: Palette.control-background;
    border-width: 1px;
    border-color: Palette.border;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[i] in root.options: Rectangle {
            border-radius: 6px;
            background: i == root.selected ? Palette.accent-background : (touch.has-hover ? Palette.alternate-background : transparent);
            Text {
                text: option;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-weight: i == root.selected ? 600 : 400;
                color: i == root.selected ? Palette.accent-foreground : Palette.foreground;
            }
            touch := TouchArea {
                clicked => {
                    if (root.selected != i) {
                        root.selected = i;
                        root.chosen(i);
                    }
                }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "govn - Cài đặt";
    icon: @image-url("icon.png");
    // Fits the tallest tab; keep in step with SIZE in settings.rs, which sets it on opening.
    preferred-width: 560px;
    preferred-height: 408px;
    min-width: 460px;
    min-height: 360px;
    default-font-size: 13px;

    // Typing
    in-out property <int> method;            // 0 Telex, 1 VNI
    in-out property <bool> w-shortcuts;      // w -> ư and [ ] -> ơ ư (Telex only)
    in-out property <bool> modern-style;
    in-out property <bool> spell-check;
    in-out property <bool> auto-restore;
    callback typing-changed();

    // Programs
    in property <[string]> english-apps;
    in property <[string]> running-apps;
    // Item 0 is a placeholder, since the combo box always shows a selection.
    in-out property <int> running-index: 0;
    in-out property <bool> remember-apps;
    callback add-app(int);                   // index in running-apps
    callback remove-app(int);
    callback refresh-running();
    callback remember-changed(bool);

    // System
    in property <[string]> hotkeys;
    in-out property <int> hotkey;
    callback hotkey-changed(int);
    in-out property <bool> autostart;
    in property <bool> autostart-enabled: true;
    callback autostart-changed(bool);
    in-out property <bool> admin;
    in property <bool> admin-busy;
    in property <string> admin-note;
    callback admin-changed(bool);
    in property <string> version;
    in property <string> update-status;
    in property <bool> update-available;
    in property <bool> checking;
    callback check-update();
    callback open-download();

    TabWidget {
        Tab {
            title: "Gõ phím";
            ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;
                    alignment: start;
                    Card {
                        title: "Kiểu gõ";
                        Segmented {
                            options: ["Telex", "VNI"];
                            selected <=> root.method;
                            chosen => { root.typing-changed(); }
                        }
                        ToggleRow {
                            label: "Gõ w thành ư, [ ] thành ơ ư";
                            detail: root.method == 0 ? "Tắt nếu bạn hay gõ code hoặc tiếng Anh có chữ w." : "Chỉ dùng cho Telex.";
                            enabled: root.method == 0;
                            checked <=> root.w-shortcuts;
                            toggled => { root.typing-changed(); }
                        }
                    }
                    Card {
                        title: "Dấu và chính tả";
                        ToggleRow {
                            label: "Bỏ dấu kiểu mới";
                            detail: "hoà, thuý thay vì hòa, thúy.";
                            checked <=> root.modern-style;
                            toggled => { root.typing-changed(); }
                        }
                        ToggleRow {
                            label: "Kiểm tra chính tả";
                            detail: "Chỉ thêm dấu khi chữ có thể là tiếng Việt.";
                            checked <=> root.spell-check;
                            toggled => { root.typing-changed(); }
                        }
                        ToggleRow {
                            label: "Tự trả về chữ gốc";
                            detail: "Gõ xong một từ không phải tiếng Việt thì trả lại đúng các phím đã gõ.";
                            checked <=> root.auto-restore;
                            toggled => { root.typing-changed(); }
                        }
                    }
                }
            }
        }

        Tab {
            title: "Ứng dụng";
            ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;
                    alignment: start;
                    Card {
                        title: "Luôn gõ tiếng Anh trong";
                        if root.english-apps.length == 0: Text {
                            text: "Chưa có ứng dụng nào. Thường dùng cho game, Terminal, phần mềm thiết kế.";
                            wrap: word-wrap;
                            color: Palette.foreground.transparentize(0.4);
                        }
                        for app[i] in root.english-apps: HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: app;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Xoá";
                                clicked => { root.remove-app(i); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.running-apps;
                                current-index <=> root.running-index;
                            }
                            Button {
                                text: "Thêm";
                                enabled: root.running-index > 0;
                                clicked => {
                                    root.add-app(root.running-index);
                                }
                            }
                            Button {
                                text: "Làm mới";
                                clicked => { root.refresh-running(); }
                            }
                        }
                        Text {
                            text: "Chọn trong các ứng dụng đang mở. Trong ngoặc là tên file chạy. Thêm xong, chuyển sang ứng dụng đó: icon ở khay thành E là đúng.";
                            wrap: word-wrap;
                            font-size: 11.5px;
                            color: Palette.foreground.transparentize(0.4);
                        }
                    }
                    Card {
                        ToggleRow {
                            label: "Nhớ tiếng Việt / tiếng Anh theo từng ứng dụng";
                            detail: "Quay lại ứng dụng nào thì dùng lại chế độ bạn để lần trước ở đó.";
                            checked <=> root.remember-apps;
                            toggled(on) => { root.remember-changed(on); }
                        }
                    }
                }
            }
        }

        Tab {
            title: "Hệ thống";
            ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;
                    alignment: start;
                    Card {
                        title: "Phím tắt bật/tắt tiếng Việt";
                        ComboBox {
                            model: root.hotkeys;
                            current-index <=> root.hotkey;
                            selected => { root.hotkey-changed(root.hotkey); }
                        }
                        Text {
                            text: "Nhấp vào biểu tượng V/E ở khay hệ thống cũng chuyển được.";
                            wrap: word-wrap;
                            font-size: 11.5px;
                            color: Palette.foreground.transparentize(0.4);
                        }
                    }
                    Card {
                        ToggleRow {
                            label: "Khởi động cùng Windows";
                            detail: root.autostart-enabled ? "" : "Đang chạy với quyền admin, govn đã tự khởi động khi đăng nhập.";
                            enabled: root.autostart-enabled;
                            checked <=> root.autostart;
                            toggled(on) => { root.autostart-changed(on); }
                        }
                        ToggleRow {
                            label: "Chạy với quyền admin";
                            detail: root.admin-note;
                            enabled: !root.admin-busy;
                            checked <=> root.admin;
                            toggled(on) => { root.admin-changed(on); }
                        }
                    }
                    Card {
                        title: "govn " + root.version;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button {
                                text: root.checking ? "Đang kiểm tra..." : "Kiểm tra cập nhật";
                                enabled: !root.checking;
                                clicked => { root.check-update(); }
                            }
                            if root.update-available: Button {
                                text: "Mở trang tải về";
                                primary: true;
                                clicked => { root.open-download(); }
                            }
                        }
                        if root.update-status != "": Text {
                            text: root.update-status;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
